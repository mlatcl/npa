\begin_layout Enumerate
Leaves fall from a tree to the ground as a Poisson process at a rate of
 one every minute.
 
\end_layout

\begin_deeper
\begin_layout Enumerate
You arrive at 4:00 pm.
 During the next ten minutes, what is the probability that you see twelve
 leaves fall? 
\end_layout

\begin_layout Enumerate
What is the probability that you see 
\begin_inset Formula $n$
\end_inset

 leaves fall where 
\begin_inset Formula $n$
\end_inset

 goes from 0 to 20? Use MATLAB! Plot the results on a graph.
 
\end_layout

\begin_layout Enumerate
Where does the curve peak? Compare the peak with the expected value, 
\begin_inset Formula $\lambda t$
\end_inset

.
 
\end_layout

\end_deeper
