Average Number in System II
\layout Standard


\begin_inset Formula \begin{eqnarray*}
\left\langle k\right\rangle _{P\left(k\right)} & = & \sum_{k=0}^{\infty}kP\left(k\right)\\
\\\\\\\\\\\\\end{eqnarray*}

\end_inset 


\layout ShortFoilhead

Average Number in System II
\layout Standard


\begin_inset Formula \begin{eqnarray*}
\left\langle k\right\rangle _{P\left(k\right)} & = & \sum_{k=0}^{\infty}kP\left(k\right)\\
 & = & \left(1-\rho\right)\sum_{k=0}^{\infty}k\rho^{k}\\
\\\\\\\\\\\end{eqnarray*}

\end_inset 


\layout ShortFoilhead

Average Number in System II
\layout Standard


\begin_inset Formula \begin{eqnarray*}
\left\langle k\right\rangle _{P\left(k\right)} & = & \sum_{k=0}^{\infty}kP\left(k\right)\\
 & = & \left(1-\rho\right)\sum_{k=0}^{\infty}k\rho^{k}\\
 & = & \rho\left(1-\rho\right)\sum_{k=0}^{\infty}k\rho^{k-1}\\
\\\\\\\\\end{eqnarray*}

\end_inset 


\layout ShortFoilhead

Average Number in System II
\layout Standard


\begin_inset Formula \begin{eqnarray*}
\left\langle k\right\rangle _{P\left(k\right)} & = & \sum_{k=0}^{\infty}kP\left(k\right)\\
 & = & \left(1-\rho\right)\sum_{k=0}^{\infty}k\rho^{k}\\
 & = & \rho\left(1-\rho\right)\sum_{k=0}^{\infty}k\rho^{k-1}\\
 & = & \rho\left(1-\rho\right)\frac{\partial\sum_{k=0}^{\infty}\rho^{k}}{\partial\rho}\\
\\\\\\\end{eqnarray*}

\end_inset 


\layout ShortFoilhead

Average Number in System II
\layout Standard


\begin_inset Formula \begin{eqnarray*}
\left\langle k\right\rangle _{P\left(k\right)} & = & \sum_{k=0}^{\infty}kP\left(k\right)\\
 & = & \left(1-\rho\right)\sum_{k=0}^{\infty}k\rho^{k}\\
 & = & \rho\left(1-\rho\right)\sum_{k=0}^{\infty}k\rho^{k-1}\\
 & = & \rho\left(1-\rho\right)\frac{\partial\sum_{k=0}^{\infty}\rho^{k}}{\partial\rho}\\
 & = & \rho\left(1-\rho\right)\frac{\partial}{\partial\rho}\left[\frac{1}{1-\rho}\right]\\
\\\\\end{eqnarray*}

\end_inset 


\layout ShortFoilhead

Average Number in System II
\layout Standard


\begin_inset Formula \begin{eqnarray*}
\left\langle k\right\rangle _{P\left(k\right)} & = & \sum_{k=0}^{\infty}kP\left(k\right)\\
 & = & \left(1-\rho\right)\sum_{k=0}^{\infty}k\rho^{k}\\
 & = & \rho\left(1-\rho\right)\sum_{k=0}^{\infty}k\rho^{k-1}\\
 & = & \rho\left(1-\rho\right)\frac{\partial\sum_{k=0}^{\infty}\rho^{k}}{\partial\rho}\\
 & = & \rho\left(1-\rho\right)\frac{\partial}{\partial\rho}\left[\frac{1}{1-\rho}\right]\\
 & = & \rho\left(1-\rho\right)\frac{1}{\left(1-\rho\right)^{2}}\\
\\\end{eqnarray*}

\end_inset 


\layout ShortFoilhead

Average Number in System II
\layout Standard


\begin_inset Formula \begin{eqnarray*}
\left\langle k\right\rangle _{P\left(k\right)} & = & \sum_{k=0}^{\infty}kP\left(k\right)\\
 & = & \left(1-\rho\right)\sum_{k=0}^{\infty}k\rho^{k}\\
 & = & \rho\left(1-\rho\right)\sum_{k=0}^{\infty}k\rho^{k-1}\\
 & = & \rho\left(1-\rho\right)\frac{\partial\sum_{k=0}^{\infty}\rho^{k}}{\partial\rho}\\
 & = & \rho\left(1-\rho\right)\frac{\partial}{\partial\rho}\left[\frac{1}{1-\rho}\right]\\
 & = & \rho\left(1-\rho\right)\frac{1}{\left(1-\rho\right)^{2}}\\
 & = & \frac{\rho}{1-\rho}\\
\end{eqnarray*}

\end_inset 


\layout ShortFoilhead

Average Number in System II
\layout Standard


\begin_inset Formula \begin{eqnarray*}
\left\langle k\right\rangle _{P\left(k\right)} & = & \sum_{k=0}^{\infty}kP\left(k\right)\\
 & = & \left(1-\rho\right)\sum_{k=0}^{\infty}k\rho^{k}\\
 & = & \rho\left(1-\rho\right)\sum_{k=0}^{\infty}k\rho^{k-1}\\
 & = & \rho\left(1-\rho\right)\frac{\partial\sum_{k=0}^{\infty}\rho^{k}}{\partial\rho}\\
 & = & \rho\left(1-\rho\right)\frac{\partial}{\partial\rho}\left[\frac{1}{1-\rho}\right]\\
 & = & \rho\left(1-\rho\right)\frac{1}{\left(1-\rho\right)^{2}}\\
 & = & \frac{\rho}{1-\rho}\\
 & = & \frac{\lambda}{\mu-\lambda}\end{eqnarray*}

\end_inset 


\layout ShortFoilhead

Variance
\layout Standard

As an exercise on the tutorial sheet, you will show that the variance of
 the number in the system is given by
\layout Standard


\begin_inset Formula \[
\textrm{var}\left[k\right]=\left\langle k^{2}\right\rangle -\left\langle k\right\rangle ^{2}=\frac{\rho}{\left(1-\rho\right)^{2}}.\]

\end_inset 

 
