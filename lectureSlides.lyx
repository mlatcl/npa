\begin_layout Caption
Definition of probability distributions from Table\InsetSpace ~

\begin_inset LatexCommand \ref{cap:basicProbabilityDistributions}

\end_inset

 in terms of the system depicted in Figure\InsetSpace ~

\begin_inset LatexCommand \ref{cap:aJointDistribution}

\end_inset

.
\end_layout

\end_inset


\end_layout

\begin_layout ShortFoilhead
Notational Details
\end_layout

\begin_layout Itemize
Typically we should write out 
\begin_inset Formula $P\left(X=x,Y=y\right)$
\end_inset

.
 
\end_layout

\begin_layout Itemize
In practice, we often use 
\begin_inset Formula $P\left(x,y\right)$
\end_inset

.
 
\end_layout

\begin_layout Itemize
This looks very much like we might write a multivariate function, 
\emph on
e.g.
 
\emph default

\begin_inset Formula $f\left(x,y\right)=\frac{x}{y}$
\end_inset

.
 
\end_layout

\begin_deeper
\begin_layout Itemize
For a multivariate function though, 
\begin_inset Formula $f\left(x,y\right)\neq f\left(y,x\right)$
\end_inset

.
 
\end_layout

\begin_layout Itemize
However 
\begin_inset Formula $P\left(x,y\right)=P\left(y,x\right)$
\end_inset

 because 
\begin_inset Formula $P\left(X=x,Y=y\right)=P\left(Y=y,X=x\right)$
\end_inset

.
\end_layout

\end_deeper
\begin_layout Itemize
We have denoted the probability distribution with a capital 
\begin_inset Formula $P$
\end_inset

.
 
\end_layout

\begin_layout Itemize
We will use capital 
\begin_inset Formula $P$
\end_inset

s consistently to denote discrete distributions.
 
\end_layout

\begin_layout Itemize
For continuous probability density functions, we will turn to small letters.
\end_layout

\begin_layout Itemize
We now consider some `rules of probability'.
\end_layout

\begin_layout ShortFoilhead
Normalisation
\end_layout

\begin_layout Standard
All distributions are normalised.
 This is clear from the fact that 
\begin_inset Formula $\sum_{x}n_{X=x}=N$
\end_inset

, which gives 
\begin_inset Formula \[
\sum_{x}P\left(x\right)=\lim_{N\rightarrow\infty}\frac{\sum_{x}n_{X=x}}{N}=\lim_{N\rightarrow\infty}\frac{N}{N}=1.\]

\end_inset

A similar result can be derived for the marginal and conditional distributions.
\end_layout

\begin_layout ShortFoilhead
The Sum Rule 
\end_layout

\begin_layout Itemize
The marginal probability 
\begin_inset Formula $P\left(y\right)$
\end_inset

 is given by 
\begin_inset Formula $\lim_{N\rightarrow\infty}\frac{n_{Y=y}}{N}$
\end_inset

.
\end_layout

\begin_layout Itemize
The joint distribution 
\begin_inset Formula $P\left(x,y\right)$
\end_inset

 is given by 
\begin_inset Formula $\lim_{N\rightarrow\infty}\frac{n_{X=x,Y=y}}{N}$
\end_inset

.
 
\end_layout

\begin_layout Itemize
\begin_inset Formula $n_{Y=y}=\sum_{x}n_{X=x,Y=y}$
\end_inset

 so
\begin_inset Formula \[
\lim_{N\rightarrow\infty}\frac{n_{Y=y}}{N}=\lim_{N\rightarrow\infty}\sum_{x}\frac{n_{X=x,Y=y}}{N},\]

\end_inset

in other words
\begin_inset Formula \[
P\left(y\right)=\sum_{x}P\left(x,y\right).\]

\end_inset

This is known as the sum rule of probability.
 
\end_layout

\begin_layout ShortFoilhead
The Product Rule
\end_layout

\begin_layout Itemize
\begin_inset Formula $P\left(x|y\right)$
\end_inset

 is given by 
\begin_inset Formula $\lim_{N\rightarrow\infty}\frac{n_{X=x,Y=y}}{n_{Y=y}}$
\end_inset

.
 
\end_layout

\begin_layout Itemize
\begin_inset Formula $P\left(x,y\right)$
\end_inset

 is given by 
\begin_inset Formula \[
\lim_{N\rightarrow\infty}\frac{n_{X=x,Y=y}}{N}=\lim_{N\rightarrow\infty}\frac{n_{X=x,Y=y}}{n_{Y=y}}\frac{n_{Y=y}}{N}\]

\end_inset

or in other words
\begin_inset Formula \[
P\left(x,y\right)=P\left(x|y\right)P\left(y\right).\]

\end_inset

This is known as the product rule of probability.
\end_layout

\begin_layout ShortFoilhead
Bayes' Rule
\end_layout

\begin_layout Itemize
From the product rule,
\begin_inset Formula \[
P\left(x,y\right)=P\left(y,x\right)=P\left(y|x\right)P\left(x\right),\]

\end_inset

 
\end_layout

\begin_deeper
\begin_layout Standard
so
\begin_inset Formula \[
P\left(x|y\right)P\left(y\right)=P\left(y|x\right)P\left(x\right)\]

\end_inset

which leads to Bayes' Rule, 
\begin_inset Formula \[
P\left(x|y\right)=\frac{P\left(y|x\right)P\left(x\right)}{P\left(y\right)}.\]

\end_inset


\end_layout

\end_deeper
\begin_layout ShortFoilhead
Independence
\end_layout

\begin_layout Itemize
The variable 
\begin_inset Formula $x$
\end_inset

 is independent of 
\begin_inset Formula $y$
\end_inset

 if the distribution over 
\begin_inset Formula $x$
\end_inset

 is not affected by the value of 
\begin_inset Formula $y$
\end_inset

:
\begin_inset Formula \[
P\left(x\right)=P\left(x|y\right),\]

\end_inset

the conditional distribution of 
\begin_inset Formula $x$
\end_inset

 given 
\begin_inset Formula $y$
\end_inset

 is equal to the marginal distribution of 
\begin_inset Formula $x$
\end_inset

.
 This in turn implies that the joint distribution factorises,
\begin_inset Formula \[
P\left(x,y\right)=P\left(x|y\right)P\left(y\right)=P\left(x\right)P\left(y\right),\]

\end_inset

and furthermore that 
\begin_inset Formula \[
P\left(y|x\right)=P\left(y\right).\]

\end_inset

The factorisation of the joint distribution when variables are independent
 turns out to be a very important property which makes a lot of analysis
 tractable.
\end_layout

\begin_layout ShortFoilhead
Expectations
\begin_inset LatexCommand \label{sec:expectations}

\end_inset


\end_layout

\begin_layout Itemize
A probabilistic model summarises our beliefs.
\end_layout

\begin_layout Itemize
Sometimes need to summarise the model by its expectations.
\end_layout

\begin_layout Itemize
Expected value of 
\begin_inset Formula $f\left(x\right)$
\end_inset

 under 
\begin_inset Formula $P\left(x\right)$
\end_inset

 is 
\begin_inset Formula \[
\left\langle f\left(x\right)\right\rangle _{P\left(x\right)}=\sum_{x}P\left(x\right)f\left(x\right).\]

\end_inset

Here we have introduced a particular notation for the expectation, you will
 also see expectations written in the form 
\begin_inset Formula $E\left\{ f\left(x\right)\right\} $
\end_inset

.
 
\end_layout

