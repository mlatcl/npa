\begin_layout Itemize
Seek a stationary distribution through global balance equations.
 
\end_layout

\begin_layout Itemize
At equilibrium the frequency of transitions out of state 
\begin_inset Formula $k$
\end_inset

 equals the frequency of transitions into 
\begin_inset Formula $k$
\end_inset

 
\begin_inset LatexCommand \citep[pg 260-262]{Bertsekas:data92}

\end_inset

.
 
