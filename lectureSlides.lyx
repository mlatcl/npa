\begin_layout Itemize
First published by 
\series bold
Sim\i \'{e}
on Denis Poisson
\series default
 (1781-1840) in 1837.
 
\end_layout

\begin_layout Itemize
Defined over the space of all non-negative integers.
 
\end_layout

\begin_layout Itemize
This set is countably infinite: impossible to summarise in a table!
\end_layout

\begin_layout Itemize
The Poisson distribution is therefore defined as
\begin_inset Formula \begin{equation}
P\left(k|\mu\right)=\frac{\mu^{k}}{k!}\exp\left(-\mu\right).\label{eq:poissonDist}\end{equation}

\end_inset

where 
\begin_inset Formula $k$
\end_inset

 is any integer from 
\begin_inset Formula $0$
\end_inset

