\begin_layout Itemize
At steady state, 
\begin_inset Formula \[
\lambda P\left(k-1\right)=\mu P\left(k\right).\]

\end_inset

 
\end_layout

\begin_layout ShortFoilhead
\begin_inset Formula $M/M/1$
\end_inset

 --- Stationary Distribution II
\end_layout

\begin_layout Itemize
At steady state, 
\begin_inset Formula \[
\lambda P\left(k-1\right)=\mu P\left(k\right).\]

\end_inset

 
\end_layout

\begin_layout Itemize
Leading to 
\begin_inset Formula \[
P\left(k\right)=\frac{\lambda}{\mu}P\left(k-1\right).\]

\end_inset

 
\end_layout

\begin_layout Itemize
Thus
\begin_inset Formula \begin{eqnarray*}
P\left(k\right) & = & \left(\frac{\lambda}{\mu}\right)^{k}P\left(0\right)\\
 & = & \rho^{k}P\left(0\right),\end{eqnarray*}

\end_inset

 
\end_layout

\begin_deeper
\begin_layout Standard
where we have defined 
\begin_inset Formula $\rho=\frac{\lambda}{\mu}$
\end_inset

, which, for the 
\begin_inset Formula $M/M/1$
\end_inset

 queue, is called the 
\emph on
utilisation factor
\emph default
.
 
\end_layout

\end_deeper
\begin_layout ShortFoilhead
Normalisation
\begin_inset LatexCommand \label{sub:normalisationMM1}

\end_inset


\end_layout

\begin_layout Itemize
To find 
\begin_inset Formula $P\left(0\right)$
\end_inset

 we use the normalisation condition.
\begin_inset Formula \[
\sum_{k=0}^{\infty}P\left(k\right)=1\]

\end_inset

 and because 
\begin_inset Formula $P\left(k\right)=\rho^{k}P\left(0\right)$
\end_inset

,
\begin_inset Formula \[
1=P\left(0\right)\sum_{k=0}^{\infty}\rho^{k}\]

\end_inset

 giving 
\begin_inset Formula \begin{equation}
P\left(0\right)=\frac{1}{\sum_{k=0}^{\infty}\rho^{k}}.\label{eq:MM1Series}\end{equation}

\end_inset

 
\end_layout

\begin_layout Itemize
The infinite series in the denominator converges if 
\begin_inset Formula $\rho<1$
\end_inset

 (when 
\begin_inset Formula $\lambda<\mu$
\end_inset

), 
\begin_inset Formula \[
\sum_{k=0}^{\infty}\rho^{k}=\frac{1}{1-\rho}\,\,\,\textrm{for\,\,\,$\rho<1$},\]

\end_inset

 so 
\begin_inset Formula $P\left(0\right)=\left(1-\rho\right)$
\end_inset

 and the full distribution for the 
\emph on
steady state
\emph default
 probabilities is 
\begin_inset Formula \[
P\left(k\right)=\rho^{k}\left(1-\rho\right).\]

\end_inset


\end_layout

\begin_layout ShortFoilhead
Faster Arrivals than Service
\end_layout

\begin_layout Standard
Notice that if the arrival rate (birth rate) is greater than the service
 rate (death rate) then 
\begin_inset Formula $\rho>1$
\end_inset

 and the series in (
\begin_inset LatexCommand \ref{eq:MM1Series}

\end_inset

) doesn't converge.
 This is indicative of the fact that if the birth rate is greater than the
 death rate there is no steady state distribution.
 The queue continues to grow in size.
\end_layout

